            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Inspección del área norte\",\n  \"descripcion\": \"Se revisaron los extintores y todos están vigentes.\",\n  \"fotoBase64\": null,\n  \"fechaCreacion\": \"2000-01-01T00:00:00Z\",\n  \"usuarioId\": 999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Incluye encabezado Location\", () => pm.response.to.have.header(\"Location\"));",
                  "const r = pm.response.json();",
                  "pm.test(\"El dueño es el usuario del token\", () => {",
                  "    pm.expect(r.usuarioId).to.eql(Number(pm.environment.get(\"usuarioAId\")));",
                  "    pm.expect(r.creadoPor).to.eql(pm.environment.get(\"correoA\"));",
                  "});",
                  "pm.test(\"La fecha la asigna el servidor\", () => pm.expect(r.fechaCreacion).to.not.include(\"2000-01-01\"));",
                  "pm.environment.set(\"registroAId\", r.id);",
                  "pm.environment.set(\"fechaCreacion\", r.fechaCreacion);"
                ]
              }
            }
          ]
        },

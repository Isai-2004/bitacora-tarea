        {
          "name": "3.5 Token alterado (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/registros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registros"
              ]
            },
            "description": "Prueba obligatoria 5a: el payload fue modificado (rol Admin) pero la firma es la original.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAlterado}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Toma el token del usuario A y cambia su rol a \"Admin\" en el payload sin volver a firmarlo.",
                  "const [cabecera, payload, firma] = pm.environment.get(\"tokenUsuarioA\").split(\".\");",
                  "const datos = JSON.parse(CryptoJS.enc.Base64.parse(payload.replace(/-/g, \"+\").replace(/_/g, \"/\")).toString(CryptoJS.enc.Utf8));",
                  "datos.role = \"Admin\";",
                  "const nuevoPayload = CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(JSON.stringify(datos)))",
                  "    .replace(/=+$/, \"\").replace(/\\+/g, \"-\").replace(/\\//g, \"_\");",
                  "pm.variables.set(\"tokenAlterado\", `${cabecera}.${nuevoPayload}.${firma}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401 Unauthorized\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Responde con ProblemDetails\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    pm.expect(pm.response.json()).to.have.property(\"title\");",
                  "});",
                  "pm.test(\"Rechaza la firma\", () => pm.expect(pm.response.json().detail).to.eql(\"El token no es válido.\"));",
                  "pm.test(\"WWW-Authenticate indica invalid_token\", () => pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.include(\"invalid_token\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "3.6 Token vencido (401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/registros",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "registros"
              ]
            },
            "description": "Prueba obligatoria 5b: token firmado correctamente pero con exp en el pasado. También se puede probar esperando 10 minutos con un token real.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenVencido}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Construye un JWT con emisor, audiencia y firma correctos, pero que venció hace 10 minutos.",
                  "// Usa la clave del entorno local (jwtClave), que NO se exporta ni se sube al repositorio.",
                  "const b64url = palabras => CryptoJS.enc.Base64.stringify(palabras).replace(/=+$/, \"\").replace(/\\+/g, \"-\").replace(/\\//g, \"_\");",
                  "const ahora = Math.floor(Date.now() / 1000);",
                  "const cabecera = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({ alg: \"HS256\", typ: \"JWT\" })));",
                  "const payload = b64url(CryptoJS.enc.Utf8.parse(JSON.stringify({",
                  "    sub: String(pm.environment.get(\"usuarioAId\")),",
                  "    email: pm.environment.get(\"correoA\"),",
                  "    role: \"Usuario\",",
                  "    iss: \"Bitacora.Api\",",
                  "    aud: \"Bitacora.Clientes\",",
                  "    iat: ahora - 1200,",
                  "    nbf: ahora - 1200,",
                  "    exp: ahora - 600",
                  "})));",
                  "const clave = pm.environment.get(\"jwtClave\") || \"clave-desconocida-solo-para-la-prueba-0000\";",
                  "if (!pm.environment.get(\"jwtClave\")) console.warn(\"Sin jwtClave: el token se rechaza por firma, no por vencimiento.\");",
                  "const firma = b64url(CryptoJS.HmacSHA256(`${cabecera}.${payload}`, clave));",
                  "pm.variables.set(\"tokenVencido\", `${cabecera}.${payload}.${firma}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401 Unauthorized\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Responde con ProblemDetails\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    pm.expect(pm.response.json()).to.have.property(\"title\");",
                  "});",
                  "if (pm.environment.get(\"jwtClave\")) {",
                  "    pm.test(\"Indica que el token venció\", () => pm.expect(pm.response.json().detail).to.include(\"venció\"));",
                  "}"
                ]
              }
            }
          ]
        },

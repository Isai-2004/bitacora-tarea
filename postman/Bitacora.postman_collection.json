    "name": "Bitácora API - Seguridad JWT",
    "description": "Pruebas de la API con autenticación JWT y autorización por roles.\n\nAntes de ejecutar: en el entorno 'Bitacora - Local' completa adminCorreo, adminContrasena (los mismos de user-secrets) y, para la prueba de token vencido, jwtClave. Ejecuta la colección completa en orden con el Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{tokenUsuarioA}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "1.1 Registrar usuario A (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoA}}\",\n  \"contrasena\": \"{{contrasenaPrueba}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Correos únicos en cada ejecución para que la colección se pueda repetir.",
                  "const marca = Date.now();",
                  "pm.environment.set(\"correoA\", `ana.${marca}@prueba.com`);",
                  "pm.environment.set(\"correoB\", `beto.${marca}@prueba.com`);",
                  "if (!pm.environment.get(\"contrasenaPrueba\")) pm.environment.set(\"contrasenaPrueba\", \"Clave1234\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.test(\"Se crea con el rol Usuario\", () => pm.expect(u.rol).to.eql(\"Usuario\"));",
                  "pm.test(\"No devuelve la contraseña ni su hash\", () => {",
                  "    pm.expect(u).to.not.have.property(\"contrasena\");",
                  "    pm.expect(u).to.not.have.property(\"contrasenaHash\");",
                  "});",
                  "pm.environment.set(\"usuarioAId\", u.id);"
                ]
              }
            }
          ]
        },

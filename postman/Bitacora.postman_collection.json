          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 409 Conflict\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Responde con ProblemDetails\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "    pm.expect(pm.response.json()).to.have.property(\"title\");",
                  "});",
                  "const claves = Object.keys(pm.response.json().errors || {}).map(k => k.toLowerCase());",
                  "pm.test(\"Informa el campo inválido: Correo\", () => pm.expect(claves).to.include(\"correo\"));"
                ]
              }
            }
          ]
        },

                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoA}}\",\n  \"contrasena\": \"{{contrasenaPrueba}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Devuelve un JWT (tres partes)\", () => pm.expect(r.token.split(\".\")).to.have.lengthOf(3));",
                  "pm.test(\"Tipo de token Bearer\", () => pm.expect(r.tipoToken).to.eql(\"Bearer\"));",
                  "pm.test(\"Rol Usuario\", () => pm.expect(r.rol).to.eql(\"Usuario\"));",
                  "pm.test(\"Vence en unos 10 minutos\", () => {",
                  "    const minutos = (new Date(r.expira) - Date.now()) / 60000;",
                  "    pm.expect(minutos).to.be.within(9, 10.1);",
                  "});",
                  "pm.environment.set(\"tokenUsuarioA\", r.token);"
                ]
              }
            }
          ]
        },
